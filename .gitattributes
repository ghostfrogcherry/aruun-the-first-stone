* text=auto eol=lf
# Large binary assets go through Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.vox filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
# Small palette-voxel art stays in normal git, so a plain download of the repo runs
# without Git LFS. (Later lines win over the LFS rules above.)
content/models/**/*.vox -filter -diff -merge
content/structures/*.vox -filter -diff -merge
content/icons/*.png -filter -diff -merge
content/art/*.png -filter -diff -merge
docs/art/*.png -filter -diff -merge
docs/unity/*.png -filter -diff -merge
